{
    "name": "Sora-Critical-Fantasy",
    "servePort": 34872,
    "tree": {
        "$className": "DataModel",

        "ReplicatedFirst": {
            "$className": "ReplicatedFirst",
            "$ignoreUnknownInstances": true,
            "$path": "sora_src/ReplicatedFirst"
        },

        "ReplicatedStorage": {
            "$className": "ReplicatedStorage",
            "$ignoreUnknownInstances": true,
            "$path": "sora_src/ReplicatedStorage",

            "Assets": {
                "$className": "Folder",
                "$ignoreUnknownInstances": true
            },

            "Packages": {
                "$className": "Folder",
                "$ignoreUnknownInstances": false,
                "$path": "Packages"
            }
        },

        "ServerStorage": {
            "$className": "ServerStorage",
            "$ignoreUnknownInstances": true,
            "$path": "sora_src/ServerStorage"
        },

        "ServerScriptService": {
            "$className": "ServerScriptService",
            "$ignoreUnknownInstances": false,
            "$path": "sora_src/ServerScriptService"
        },

        "StarterPlayer": {
            "$className": "StarterPlayer",
            "$ignoreUnknownInstances": false,

            "Client": {
                "$path": "sora_src/StarterPlayer/Client.client.luau"
            },

            "Signals": {
                "$path": "sora_src/StarterPlayer/Signals"
            },

            "StarterPlayerScripts": {
                "$className": "StarterPlayerScripts",
                "$ignoreUnknownInstances": false,
                "$path": "sora_src/StarterPlayer/StarterPlayerScripts"
            },

            "StarterCharacterScripts": {
                "$className": "StarterCharacterScripts",
                "$ignoreUnknownInstances": false,
                "$path": "sora_src/StarterPlayer/StarterCharacterScripts"
            }
        }
    }
}
{
    "robloxLsp.workspace.ignoreDir": [
        ".vscode",
        "**/_Index/**",
    ],
    "robloxLsp.diagnostics.disable": [
        "undefined-type",
        "redefined-type"
    ],

    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "sourcemap.json": true,

        "src/RbxCharacterSounds.client.luau": true,
        //"src/shared/Shared/HarukaCMD": true,
        "src/shared/Library/LocationBook.luau": true,
        "src/DS_VERSION.luau": true
    },
    "robloxLsp.diagnostics.globals": [
        "Path2DControlPoint"
    ],
    "stylua.disableVersionCheck": true,
}

{
    "name": "Critical-Fantasy_Rojo",
    "servePort": 34874,
    "tree": {
        "$className": "DataModel",

        "ReplicatedFirst": {
            "$className": "ReplicatedFirst",
            "$ignoreUnknownInstances": true,

            "HarukaPreload": {
                "$className": "Folder",
                "$path": "src/preload"
            }
        },
        "ReplicatedStorage": {
            "$className": "ReplicatedStorage",
            "$ignoreUnknownInstances": true,

            "HarukaShared": {
                "$className": "Folder",
                "$path": "src/shared"
            },
            "HarukaRes": {
                "$className": "Folder",
                "$path": "src/res"
            },
            "VERSION": {
                "$path": "src/VERSION.luau"
            }
        },
        "ServerScriptService": {
            "$className": "ServerScriptService",
            "$ignoreUnknownInstances": true,

            "HarukaServer": {
                "$className": "Folder",
                "$path": "src/server"
            }
        },
        "ServerStorage": {
            "$className": "ServerStorage",
            "$ignoreUnknownInstances": true,

            "HarukaServerStorage": {
                "$className": "Folder",
                "$path": "src/storage"
            }
        },
        "StarterPlayer": {
            "$className": "StarterPlayer",
            "$ignoreUnknownInstances": true,

            "StarterCharacterScripts": {
                "$className": "StarterCharacterScripts",
                "$ignoreUnknownInstances": true,

                "HarukaChar": {
                    "$className": "Folder",
                    "$path": "src/character"
                }
            },
            "StarterPlayerScripts": {
                "$className": "StarterPlayerScripts",
                "$ignoreUnknownInstances": true,

                "HarukaClient": {
                    "$className": "Folder",
                    "$path": "src/client"
                },
                "RbxCharacterSounds": {
                    "$path": "src/RbxCharacterSounds.client.luau"
                }
            }
        }
    }
}
